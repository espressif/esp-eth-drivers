# Role-specific overrides; shared ESP32 settings: sdkconfig.defaults.esp32 (see README).
CONFIG_EXAMPLE_LAN86XX_ROLE_CLIENT=y
CONFIG_EXAMPLE_CLIENT_CONNECT_TO_SERVER=n

CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_USE_SPI_ETHERNET=n
CONFIG_ETHERNET_INTERNAL_SUPPORT=y
CONFIG_ETHERNET_PHY_LAN867X=y
CONFIG_ETHERNET_PHY_INTERFACE_RMII=y
CONFIG_ETHERNET_RMII_CLK_INPUT=y
CONFIG_ETHERNET_RMII_CLK_GPIO=0
CONFIG_ETHERNET_PHY_ADDR=-1
CONFIG_ETHERNET_BOARD_SPECIFIC_INIT_DEFAULT=y
CONFIG_ETHERNET_EXT_OSC_EN_GPIO_NUM=2

CONFIG_ETHERNET_USE_PLCA=y
CONFIG_ETHERNET_PLCA_FOLLOWER=y
CONFIG_ETHERNET_PLCA_ID=2
